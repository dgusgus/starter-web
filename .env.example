# Copia este archivo a .env. Las variables VITE_* quedan visibles en el navegador:
# nunca pongas secretos aquí.

# URL base de la API (starter-api)
VITE_API_URL=http://localhost:3000/api/v1

# Nombre que se muestra en el título y la barra lateral
VITE_APP_NAME=Starter Web

# Formato de moneda y fechas
VITE_LOCALE=es-BO
VITE_CURRENCY=BOB
